# API
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated allowed browser origins (web dev + preview + local production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000
# Set to 1 only when the web app is served by the API (single-machine production)
SERVE_WEB=0

# SQLite lives next to the Prisma schema (apps/api/prisma/dev.db)
DATABASE_URL="file:./dev.db"

# Secrets: generate with `openssl rand -base64 48`
JWT_SECRET=change-me-in-production-please-use-a-long-random-secret
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
# Demo seed credentials are only created when SEED_DEMO=1
SEED_DEMO=1
