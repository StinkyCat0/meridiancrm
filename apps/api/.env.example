# API
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated allowed browser origins (web dev + preview + local production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000
# Set to 1 only when the web app is served by the API (single-machine production)
SERVE_WEB=0

# SQLite lives next to the Prisma schema (apps/api/prisma/dev.db)
DATABASE_URL="file:./dev.db"

# Secrets: generate with `openssl rand -base64 48`
JWT_SECRET=change-me-in-production-please-use-a-long-random-secret
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
# Demo seed credentials are only created when SEED_DEMO=1
SEED_DEMO=1

# Public URL of the web app, used in invite links
WEB_APP_URL=http://localhost:5173

# Set only when behind a trusted reverse proxy (e.g. 127.0.0.1 or a CIDR). Never true when directly exposed.
TRUST_PROXY=false
# 1 behind TLS, 0 for local HTTP (default is NODE_ENV=production).
COOKIE_SECURE=0

# Server-to-server website lead intake (POST /api/v1/public/intake).
# The website must send this exact value in the x-meridian-intake-secret header.
# Use the same value as CRM_INTAKE_SECRET on the website. Must be at least 32
# characters and must not contain placeholder words; a weak value disables
# intake outside production and fails startup in production. Generate with:
#   openssl rand -base64 48
WEBSITE_INTAKE_SECRET=change-me-replace-with-openssl-rand-base64-48
# Slug of the workspace that receives website inquiries.
WEBSITE_INTAKE_WORKSPACE_SLUG=meridian-studio
