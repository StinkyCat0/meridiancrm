// Meridian CRM data model. SQLite today; switching provider to postgres needs no app rewrite.
// SQLite has no native enums: role/kind/type are validated at the API boundary via Zod.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships      Membership[]
  refreshTokens    RefreshToken[]
  ownedCompanies   Company[]       @relation("CompanyOwner")
  ownedContacts    Contact[]       @relation("ContactOwner")
  ownedDeals       Deal[]          @relation("DealOwner")
  ownedActivities  Activity[]      @relation("ActivityOwner")
  auditEntries     AuditLog[]      @relation("AuditActor")
  invitesSent      Invite[]        @relation("InviteSender")
  stageChanges     StageHistory[]  @relation("StageChanger")
  assignedJobs     Job[]           @relation("JobAssignee")
  ownedEstimates   Estimate[]      @relation("EstimateOwner")
  communications   Communication[] @relation("CommunicationAuthor")
  expenses         Expense[]       @relation("ExpenseOwner")
  paymentsRecorded Payment[]       @relation("PaymentRecorder")
}

model Workspace {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  currency       String   @default("USD")
  businessType   String   @default("GENERAL")
  timezone       String   @default("America/Chicago")
  serviceArea    String?
  depotLatitude  Float?
  depotLongitude Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships      Membership[]
  companies        Company[]
  contacts         Contact[]
  pipelines        Pipeline[]
  deals            Deal[]
  activities       Activity[]
  invites          Invite[]
  auditLogs        AuditLog[]
  locations        Location[]
  services         ServiceItem[]
  jobs             Job[]
  estimates        Estimate[]
  invoices         Invoice[]
  payments         Payment[]
  expenses         Expense[]
  communications   Communication[]
  automationRules  AutomationRule[]
  automationRuns   AutomationRun[]
  documentCounters DocumentCounter[]
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        String   @default("MEMBER")
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  customerType String   @default("COMMERCIAL")
  domain       String?
  industry     String?
  size         String?
  phone        String?
  email        String?
  website      String?
  address      String?
  notes        String?
  tags         String   @default("[]")
  archived     Boolean  @default(false)
  ownerId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner          User?           @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts       Contact[]
  deals          Deal[]
  activities     Activity[]
  locations      Location[]
  jobs           Job[]
  estimates      Estimate[]
  invoices       Invoice[]
  communications Communication[]

  @@index([workspaceId, archived])
  @@index([workspaceId, name])
  @@index([workspaceId, customerType])
}

model Contact {
  id          String   @id @default(cuid())
  workspaceId String
  firstName   String
  lastName    String
  email       String?
  phone       String?
  title       String?
  companyId   String?
  ownerId     String?
  tags        String   @default("[]")
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company        Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner          User?           @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  deals          Deal[]
  activities     Activity[]
  jobs           Job[]
  estimates      Estimate[]
  communications Communication[]

  @@index([workspaceId, archived])
  @@index([workspaceId, email])
  @@index([workspaceId, lastName])
  @@index([workspaceId, companyId])
}

model Pipeline {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    Stage[]
  deals     Deal[]

  @@index([workspaceId])
}

model Stage {
  id          String @id @default(cuid())
  pipelineId  String
  name        String
  order       Int
  probability Int    @default(20)
  kind        String @default("OPEN")
  targetDays  Int    @default(30)

  pipeline Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]
  history  StageHistory[]

  @@unique([pipelineId, order])
}

model Deal {
  id                String    @id @default(cuid())
  workspaceId       String
  pipelineId        String
  stageId           String
  title             String
  value             Int
  currency          String    @default("USD")
  contactId         String?
  companyId         String?
  ownerId           String?
  expectedCloseDate DateTime?
  closedAt          DateTime?
  description       String?
  tags              String    @default("[]")
  stageChangedAt    DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline   Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage      Stage          @relation(fields: [stageId], references: [id])
  contact    Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company    Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner      User?          @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities Activity[]
  history    StageHistory[]

  @@index([workspaceId, stageId])
  @@index([workspaceId, closedAt])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, companyId])
  @@index([workspaceId, contactId])
  @@index([workspaceId, ownerId])
}

model StageHistory {
  id          String   @id @default(cuid())
  dealId      String
  stageId     String
  fromStageId String?
  changedById String?
  changedAt   DateTime @default(now())

  deal      Deal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  stage     Stage @relation(fields: [stageId], references: [id])
  changedBy User? @relation("StageChanger", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([dealId, changedAt])
}

model Activity {
  id          String    @id @default(cuid())
  workspaceId String
  type        String    @default("NOTE")
  title       String
  body        String?
  dueAt       DateTime?
  completedAt DateTime?
  contactId   String?
  companyId   String?
  dealId      String?
  ownerId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal      Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  owner     User?     @relation("ActivityOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([workspaceId, completedAt, dueAt])
  @@index([workspaceId, createdAt])
  @@index([dealId])
  @@index([workspaceId, contactId])
  @@index([workspaceId, companyId])
}

model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        String    @default("MEMBER")
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([workspaceId])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  metadata    String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Service operations
 */
/**
 * --------------------------------------------------------------------------
 */

model Location {
  id           String   @id @default(cuid())
  workspaceId  String
  customerId   String
  label        String   @default("Main")
  line1        String
  line2        String?
  city         String
  state        String?
  postalCode   String?
  country      String?
  accessNotes  String?
  gateCode     String?
  contactName  String?
  contactPhone String?
  latitude     Float?
  longitude    Float?
  isPrimary    Boolean  @default(false)
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer  Company    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobs      Job[]
  estimates Estimate[]
  invoices  Invoice[]

  @@index([workspaceId, customerId])
  @@index([workspaceId, customerId, isPrimary])
  @@index([workspaceId, archived])
}

model ServiceItem {
  id              String   @id @default(cuid())
  workspaceId     String
  name            String
  category        String?
  description     String?
  unit            String   @default("VISIT")
  durationMinutes Int      @default(60)
  price           Int      @default(0)
  cost            Int      @default(0)
  taxable         Boolean  @default(true)
  archived        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  jobLines      JobLineItem[]
  estimateLines EstimateLineItem[]

  @@index([workspaceId, archived])
  @@index([workspaceId, name])
  @@index([workspaceId, category])
}

model Job {
  id              String    @id @default(cuid())
  workspaceId     String
  number          String
  title           String
  status          String    @default("UNSCHEDULED")
  priority        String    @default("NORMAL")
  source          String?
  customerId      String
  locationId      String
  contactId       String?
  assigneeId      String?
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  arrivedAt       DateTime?
  completedAt     DateTime?
  durationMinutes Int       @default(60)
  taxRate         Int       @default(0)
  subtotal        Int       @default(0)
  tax             Int       @default(0)
  total           Int       @default(0)
  deposit         Int       @default(0)
  notes           String?
  cancelReason    String?
  rating          Int?
  ratingNote      String?
  recurrence      String?
  recurrenceUntil DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer       Company         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  location       Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  contact        Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignee       User?           @relation("JobAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  lineItems      JobLineItem[]
  invoices       Invoice[]
  estimates      Estimate[]
  communications Communication[]
  expenses       Expense[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
  @@index([workspaceId, scheduledStart])
  @@index([workspaceId, scheduledStart, assigneeId])
  @@index([workspaceId, customerId])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, completedAt])
}

model JobLineItem {
  id        String  @id @default(cuid())
  jobId     String
  serviceId String?
  name      String
  quantity  Float   @default(1)
  unitPrice Int
  unitCost  Int     @default(0)
  total     Int
  position  Int     @default(0)

  job     Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  service ServiceItem? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([serviceId])
}

model Estimate {
  id          String    @id @default(cuid())
  workspaceId String
  number      String
  title       String
  status      String    @default("DRAFT")
  customerId  String
  locationId  String
  contactId   String?
  ownerId     String?
  jobId       String?
  issuedAt    DateTime?
  expiresAt   DateTime?
  taxRate     Int       @default(0)
  subtotal    Int       @default(0)
  tax         Int       @default(0)
  total       Int       @default(0)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer  Company            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  location  Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  contact   Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner     User?              @relation("EstimateOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  job       Job?               @relation(fields: [jobId], references: [id], onDelete: SetNull)
  lineItems EstimateLineItem[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, customerId])
  @@index([workspaceId, jobId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, expiresAt])
}

model EstimateLineItem {
  id         String  @id @default(cuid())
  estimateId String
  serviceId  String?
  name       String
  quantity   Float   @default(1)
  unitPrice  Int
  unitCost   Int     @default(0)
  total      Int
  position   Int     @default(0)

  estimate Estimate     @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  service  ServiceItem? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([estimateId])
  @@index([serviceId])
}

model Invoice {
  id          String    @id @default(cuid())
  workspaceId String
  number      String
  title       String
  status      String    @default("DRAFT")
  customerId  String
  locationId  String?
  jobId       String?
  amount      Int       @default(0)
  amountPaid  Int       @default(0)
  issuedAt    DateTime?
  dueAt       DateTime?
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer  Company   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  location  Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  job       Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  payments  Payment[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
  @@index([workspaceId, status, dueAt])
  @@index([workspaceId, customerId])
  @@index([workspaceId, jobId])
  @@index([workspaceId, dueAt])
  @@index([workspaceId, createdAt])
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Service-provider operations
 */
/**
 * --------------------------------------------------------------------------
 */

model DocumentCounter {
  workspaceId String
  prefix      String
  value       Int    @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, prefix])
}

model Payment {
  id           String   @id @default(cuid())
  workspaceId  String
  invoiceId    String
  amount       Int
  method       String   @default("CARD")
  reference    String?
  receivedAt   DateTime @default(now())
  recordedById String?
  createdAt    DateTime @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice    Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy User?     @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, receivedAt])
  @@index([invoiceId])
  @@index([workspaceId, invoiceId])
}

model Expense {
  id          String   @id @default(cuid())
  workspaceId String
  category    String   @default("OTHER")
  vendor      String?
  description String
  amount      Int
  incurredAt  DateTime @default(now())
  jobId       String?
  userId      String?
  receiptUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job       Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  user      User?     @relation("ExpenseOwner", fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, incurredAt])
  @@index([workspaceId, category])
  @@index([jobId])
}

model Communication {
  id          String    @id @default(cuid())
  workspaceId String
  channel     String    @default("SMS")
  direction   String    @default("OUTBOUND")
  status      String    @default("SENT")
  intent      String    @default("GENERAL")
  sentiment   String    @default("NEUTRAL")
  subject     String?
  body        String?
  customerId  String?
  contactId   String?
  jobId       String?
  userId      String?
  provider    String    @default("log")
  externalId  String?
  aiGenerated Boolean   @default(false)
  aiRationale String?
  readAt      DateTime?
  occurredAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer  Company?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  job       Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  user      User?     @relation("CommunicationAuthor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, occurredAt])
  @@index([workspaceId, customerId, occurredAt])
  @@index([workspaceId, channel])
  @@index([workspaceId, readAt])
  @@index([jobId])
}

model AutomationRule {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  trigger     String
  conditions  String    @default("{}")
  actions     String    @default("[]")
  enabled     Boolean   @default(true)
  runCount    Int       @default(0)
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs      AutomationRun[]

  @@index([workspaceId, enabled])
  @@index([workspaceId, trigger])
}

model AutomationRun {
  id          String   @id @default(cuid())
  workspaceId String
  ruleId      String
  trigger     String
  status      String   @default("SUCCESS")
  entityType  String
  entityId    String?
  detail      String?
  createdAt   DateTime @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rule      AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([ruleId, createdAt])
}
